{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://npcbench.local/schema/judgment-0.1.json",
  "title": "NPCBench semantic judgment 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["scores", "role_break", "secret_leak", "unsupported_claims", "evidence", "rationale"],
  "properties": {
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["character_fidelity", "world_consistency", "response_relevance", "style_adherence", "privacy_adherence", "action_grounding"],
      "properties": {
        "character_fidelity": {"type": "integer", "minimum": 1, "maximum": 5},
        "world_consistency": {"type": "integer", "minimum": 1, "maximum": 5},
        "response_relevance": {"type": "integer", "minimum": 1, "maximum": 5},
        "style_adherence": {"type": "integer", "minimum": 1, "maximum": 5},
        "privacy_adherence": {"type": "integer", "minimum": 1, "maximum": 5},
        "action_grounding": {"type": "integer", "minimum": 1, "maximum": 5}
      }
    },
    "role_break": {"type": "boolean"},
    "secret_leak": {"type": "boolean"},
    "unsupported_claims": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "rationale": {"type": "string", "minLength": 1}
  }
}

